# Cloudflare R2 (S3-compatible object storage)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
# Public images viewer host only — no trailing slash
# Full recipe URL: {R2_PUBLIC_BASE_URL}/recipes/recipe_{id}.webp
R2_PUBLIC_BASE_URL=https://images-viewer.tlakaniviewerimages.workers.dev

# Evolution API (WhatsApp session provider)
EVOLUTION_API_BASE_URL=https://your-evolution-host
EVOLUTION_API_KEY=your_evolution_api_key

# Stripe (API version 2024-06-20)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret
STRIPE_PRICE_ID_COACH=price_or_prod_coach
STRIPE_PRICE_ID_STUDIO=price_or_prod_studio
STRIPE_PRICE_ID_PRO=price_or_prod_pro
STRIPE_PRICE_ID_BUSINESS=price_or_prod_business
STRIPE_PRICE_ID_PERSONALIZED=price_or_prod_personalized
STRIPE_BILLING_PORTAL_RETURN_URL=http://localhost:4200/tlakani-account
